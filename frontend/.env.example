VITE_API_URL=http://localhost:3000/api

# Keycloak: the SPA talks to Keycloak directly (Authorization Code + PKCE) since the backend
# has no /auth/login endpoint — it only validates already-issued JWTs. See docs/keycloak.md.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=rosterflow
VITE_KEYCLOAK_CLIENT_ID=rosterflow-backend
