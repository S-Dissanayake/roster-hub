PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
DB_NAME=rosterflow

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=rosterflow
KEYCLOAK_CLIENT_ID=rosterflow-backend

# Confidential service-account client, used server-side only to call Keycloak's Admin API
# (creating users for the "Create User" UI). Never expose this secret to the frontend.
KEYCLOAK_ADMIN_CLIENT_ID=rosterflow-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
